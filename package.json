{
  "name": "dsh-backup",
  "version": "0.5.9",
  "description": "定时备份（dsh-backup）：每个计划独立间隔，多选来源目录、单选目标目录；支持复制/zip/tar.gz、排除规则、保留份数轮转、完整性校验、运行历史，以及在线恢复与「离线恢复脚本」（关掉 DSH 后双击运行，等文件锁释放再覆盖）。带设置页。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "backup",
    "scheduler",
    "备份"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  }
}
